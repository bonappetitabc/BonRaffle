<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="BonRaffle.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PageRoot" Background="#17251E" KeyDown="PageRoot_KeyDown" PreviewKeyDown="PageRoot_PreviewKeyDown" SizeChanged="PageRoot_SizeChanged">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Source="ms-appx:///Assets/background-bon-raffle.png" />
        <Border x:Name="BackgroundShade" Background="#AA000000" />
        <Grid Padding="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                <Image x:Name="HeaderLogo" Source="ms-appx:///Assets/logo-bon-raffle.png" MaxWidth="300" MaxHeight="70" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" ImageOpened="HeaderLogo_ImageOpened" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Главная" Click="Home_Click" UseSystemFocusVisuals="False" />
                    <Button Content="Настройки" Click="Settings_Click" />
                    <Button Content="Выход" Click="Exit_Click" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="HomeView" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680" Spacing="16" Padding="0,24,0,24">
                    <InfoBar x:Name="UpdateNotice" IsOpen="False" IsClosable="True" Severity="Informational" Message="Доступно обновление приложения.">
                        <InfoBar.ActionButton><Button Content="Посмотреть" Click="ShowUpdates_Click" /></InfoBar.ActionButton>
                    </InfoBar>
                    <TextBlock Text="Проведите розыгрыш" FontSize="36" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="HomeSubtitle" Text="Попробуйте демонстрационный список или загрузите свой." Foreground="#D3E4D7" TextAlignment="Center" TextWrapping="Wrap" FontSize="16" />
                    <Border x:Name="HomeCard" Background="#99000000" CornerRadius="18" Padding="28" Margin="0,18,0,0">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button x:Name="ParticipantsModeButton" Content="Участники" Click="ParticipantsMode_Click" />
                                <Button x:Name="PrizesModeButton" Content="Призы" Click="PrizesMode_Click" />
                            </StackPanel>
                            <TextBlock x:Name="MemberCount" Text="0 участников" FontSize="32" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                            <TextBlock x:Name="FileStatus" Text="Выберите файл со списком" Foreground="#BED5C5" TextAlignment="Center" TextWrapping="Wrap" />
                            <ProgressRing x:Name="ImportProgress" IsActive="False" Visibility="Collapsed" Width="32" Height="32" HorizontalAlignment="Center" />
                            <Button x:Name="ImportButton" Content="Загрузить участников" Click="Import_Click" HorizontalAlignment="Center" MinWidth="220" MinHeight="46" />
                            <Button x:Name="ManualListButton" Content="Создать свой список" Click="ManualList_Click" HorizontalAlignment="Center" MinWidth="220" MinHeight="42" />
                            <Button x:Name="PrizeListButton" Content="Создать или изменить призы" Click="PrizeRaffle_Click" HorizontalAlignment="Center" MinWidth="220" MinHeight="42" />
                            <Button x:Name="MaxExportButton" Content="Выгрузить участников из MAX" Click="MaxExport_Click" HorizontalAlignment="Center" MinWidth="220" MinHeight="42" />
                            <Button x:Name="OpenRaffleButton" Content="Открыть розыгрыш" Click="OpenRaffle_Click" UseSystemFocusVisuals="False" HorizontalAlignment="Center" MinWidth="220" MinHeight="46" IsEnabled="False" Background="#D2691E" Foreground="White" BorderBrush="#EC9A5C" PointerEntered="ActionButton_PointerEntered" PointerExited="ActionButton_PointerExited" PointerPressed="ActionButton_PointerPressed" PointerReleased="ActionButton_PointerReleased">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D2691E" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B95C1A" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#EC9A5C" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#EC9A5C" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="RaffleView" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="0,4,0,12">
                    <StackPanel x:Name="CountdownPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="CountdownCaptionText" Text="Конкурс начнётся через" Foreground="#D3E4D7" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
                        <Viewbox x:Name="CountdownViewbox" Width="108" Height="108" Stretch="Uniform" HorizontalAlignment="Center">
                        <Grid Width="108" Height="108">
                            <Ellipse Width="96" Height="96" Stroke="#557D94A7" StrokeThickness="7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse x:Name="CountdownArc" Width="96" Height="96" Stroke="#D2691E" StrokeThickness="7" StrokeDashCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Button x:Name="CountdownButton" Click="Countdown_Click" UseSystemFocusVisuals="False" Width="86" Height="86" CornerRadius="43" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#AA102335" BorderThickness="0">
                                <StackPanel HorizontalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="CountdownTime" Text="05:00" FontSize="22" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="CountdownAction" Text="Запустить" FontSize="10" TextAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        </Viewbox>
                    </StackPanel>
                    <StackPanel x:Name="RemainingHeader" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="RaffleCount" FontSize="36" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                        <TextBlock x:Name="RemainingCaption" Text="ЕЩЁ МОГУТ ВЫИГРАТЬ" Foreground="#D0DDD1" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
                    </StackPanel>
                    <Border x:Name="DrumBorder" Background="#99000000" BorderBrush="#D36A1C" BorderThickness="2" CornerRadius="18" Padding="12" Width="440" HorizontalAlignment="Center">
                        <Grid Height="344">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,412,344" />
                            </Grid.Clip>
                            <StackPanel x:Name="Slots" Spacing="6" />
                            <Border x:Name="SelectionFrame" Height="64" VerticalAlignment="Top" Margin="0,140,0,0"
                                    Background="#553A6A96" BorderBrush="#3A6A96" BorderThickness="2"
                                    CornerRadius="10" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <Button x:Name="SpinButton" Content="Выбрать победителя" Click="Spin_Click" UseSystemFocusVisuals="False" MinWidth="240" MinHeight="48" Background="#D2691E" Foreground="White" BorderBrush="#EC9A5C" PointerEntered="ActionButton_PointerEntered" PointerExited="ActionButton_PointerExited" PointerPressed="ActionButton_PointerPressed" PointerReleased="ActionButton_PointerReleased">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D2691E" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B95C1A" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#EC9A5C" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#EC9A5C" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="WinnerView" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Canvas x:Name="BalloonLayer" Grid.Row="0" IsHitTestVisible="False" />
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Spacing="16" Padding="0,14,0,12">
                    <TextBlock x:Name="WinnerHeading" Text="Поздравляем с победой!" FontSize="27" FontWeight="Bold" Foreground="#F5D68F" TextAlignment="Center" TextWrapping="Wrap" />
                    <Grid HorizontalAlignment="Center">
                    <Border x:Name="WinnerCard" Background="#FFD2691E" BorderBrush="#E9B965" BorderThickness="2" CornerRadius="24" Padding="28,24,28,22" Width="460">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Border Width="108" Height="108" CornerRadius="54" HorizontalAlignment="Center" BorderBrush="#F5C978" BorderThickness="3" Padding="4" Background="#61351E">
                                <Border CornerRadius="48" Background="#244060">
                                    <Grid>
                                        <Ellipse Fill="#244060" />
                                        <Ellipse x:Name="WinnerAvatarSurface">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Source, ElementName=WinnerAvatar}" Stretch="UniformToFill">
                                                    <ImageBrush.RelativeTransform>
                                                        <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.08" ScaleY="1.08" />
                                                    </ImageBrush.RelativeTransform>
                                                </ImageBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Image x:Name="WinnerAvatar" Stretch="UniformToFill" Opacity="0" />
                                        <TextBlock x:Name="WinnerGiftIcon" Text="🎁" FontSize="60" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Border>
                            <TextBlock x:Name="WinnerName" FontSize="34" FontWeight="SemiBold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="390" />
                            <TextBlock x:Name="WinnerUsername" FontSize="16" Foreground="#F1D3AD" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                            <Border x:Name="WinnerIdBadge" Background="#26FFFFFF" CornerRadius="10" Padding="16,8" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock x:Name="WinnerId" FontSize="14" Foreground="#F2E3D0" TextAlignment="Center" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock x:Name="WinnerPosition" FontSize="13" Foreground="#F2E3D0" TextAlignment="Center" Visibility="Collapsed" />
                            <Button x:Name="CopyWinnerIdButton" Content="Скопировать ID" Click="CopyWinnerId_Click" HorizontalAlignment="Center" MinWidth="156" BorderBrush="#99F5C978" Foreground="White" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
                <Canvas x:Name="StarShowerLayer" Grid.Row="0" IsHitTestVisible="False" />
                <Button x:Name="AgainButton" Grid.Row="1" Content="Провести ещё один розыгрыш" Click="OpenRaffle_Click" UseSystemFocusVisuals="False" MinHeight="48" MinWidth="320" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,8,0,12" Background="#D2691E" Foreground="White" BorderBrush="#EC9A5C" PointerEntered="ActionButton_PointerEntered" PointerExited="ActionButton_PointerExited" PointerPressed="ActionButton_PointerPressed" PointerReleased="ActionButton_PointerReleased">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D2691E" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B95C1A" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#EC9A5C" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#EC9A5C" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
        <Button x:Name="AvatarStatusButton" Click="AvatarStatus_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Width="44" Height="44" CornerRadius="22" Background="#BB000000" Foreground="White" Padding="0" Visibility="Collapsed">
            <Grid Width="36" Height="36">
                <Ellipse Stroke="#77F3DCA7" StrokeThickness="3" />
                <Path x:Name="AvatarProgressArc" Stroke="#F5C978" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <TextBlock x:Name="AvatarProgressText" Text="0%" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </Grid>
</Page>
