# Only reviewed public files may be added with ordinary git add.
# Check the staged diff before every push: ignore rules do not protect tracked files.
/*
!/.gitignore
!/README.md
!/LICENSE
!/docs/
!/Bon Raffle/
!/.github/

/.github/*
!/.github/README.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/bon-raffle-pages.yml

/docs/*
!/docs/index.html
!/docs/.nojekyll
!/docs/site/
/docs/site/*
!/docs/site/app.js
!/docs/site/style.css
!/docs/site/app-icon.png
!/docs/screenshots/
